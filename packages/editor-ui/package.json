{
  "name": "@nextcms/editor-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared editor UI primitives for NextCMS page builder and dashboard builder: tokens, shell, panels, inspector parts, overlays, and feedback states.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./gallery": "./src/gallery/index.tsx",
    "./tokens.css": "./src/tokens.css",
    "./editor-ui.css": "./dist/editor-ui.css"
  },
  "scripts": {
    "test": "tsx --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit -p .",
    "build:css": "node scripts/build-css.mjs",
    "watch:css": "node scripts/build-css.mjs --watch",
    "check:size": "node scripts/check-size.mjs",
    "build": "pnpm build:css && pnpm check:size"
  },
  "dependencies": {
    "@nextcms/builder-core": "workspace:*",
    "@radix-ui/react-alert-dialog": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-direction": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "lucide-react": "^0.552.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsx": "^4.19.0",
    "lucide-react": "0.552.0"
  }
}
